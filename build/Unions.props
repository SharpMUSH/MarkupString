<Project>
  <!--
    C# unions (the `union` declaration, and matching on one) for the project that imports this from its
    body: NETCoreSdkVersion is not known yet in Directory.Build.props.

    The .NET 11 SDK's compiler has unions. The .NET 10 SDK's does not, so with it the C# compiler from
    Microsoft.Net.Compilers.Toolset is used, at LangVersion preview, and its `dotnet format` (which cannot
    parse a union) skips the *.Union.cs files in the build's formatting check. CI checks them on .NET 11.
  -->
  <PropertyGroup>
    <MarkupStringSdkMajor>$([System.Version]::Parse($(NETCoreSdkVersion.Split('-')[0])).Major)</MarkupStringSdkMajor>
    <LangVersion Condition="$(MarkupStringSdkMajor) &lt; 11">preview</LangVersion>
    <FormatVerificationExclude Condition="$(MarkupStringSdkMajor) &lt; 11">--exclude &quot;**/*.Union.cs&quot;</FormatVerificationExclude>
  </PropertyGroup>

  <ItemGroup Condition="$(MarkupStringSdkMajor) &lt; 11">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
