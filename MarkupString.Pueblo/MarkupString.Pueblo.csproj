<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MarkupString.Pueblo</AssemblyName>
    <RootNamespace>MarkupString.Pueblo</RootNamespace>
    <PackageId>MarkupString.Pueblo</PackageId>
    <Title>MarkupString.Pueblo</Title>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <!-- No baseline until the first release is out; add PackageValidationBaselineVersion then. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <Description>Pueblo for MarkupString: writes the shared vocabulary — sounds, pictures, panes, clearing the screen, prefetching — in the Pueblo client's own HTML extensions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkupString\MarkupString.csproj" />
    <ProjectReference Include="..\MarkupString.Html\MarkupString.Html.csproj" />
  </ItemGroup>
</Project>
