<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MarkupString.AotSmoke</AssemblyName>
    <RootNamespace>MarkupString.AotSmoke</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Rooting the three assemblies is the point of this project: without it the trimmer keeps only
    what Program.cs reaches, and a trim- or AOT-hostile corner of the library that no smoke test
    happens to call would publish clean. Rooted, every public entry point is analysed, so an
    IL2xxx/IL3xxx warning surfaces here rather than in a consumer's app.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="MarkupString" />
    <TrimmerRootAssembly Include="MarkupString.Ansi" />
    <TrimmerRootAssembly Include="MarkupString.Extensions.DependencyInjection" />
    <TrimmerRootAssembly Include="MarkupString.Html" />
    <TrimmerRootAssembly Include="MarkupString.Mxp" />
    <TrimmerRootAssembly Include="MarkupString.Pueblo" />
  </ItemGroup>

  <!--
    The .NET 11 RC2 SDK ships 10.0.13 as the net10.0 ILCompiler, which has a high-severity advisory
    (GHSA-p3jp-9v83-76w9), so restore fails under warnings-as-errors. global.json rolls forward to
    the newest SDK, so anyone with SDK 11 installed hits this. Raise exactly that version to the patched
    10.0.14 the .NET 10 SDK already uses; on any other SDK the update matches nothing.
  -->
  <ItemGroup>
    <KnownILCompilerPack Update="@(KnownILCompilerPack->WithMetadataValue('TargetFramework', 'net10.0')->WithMetadataValue('ILCompilerPackVersion', '10.0.13'))"
                         ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkupString\MarkupString.csproj" />
    <ProjectReference Include="..\MarkupString.Ansi\MarkupString.Ansi.csproj" />
    <ProjectReference Include="..\MarkupString.Extensions.DependencyInjection\MarkupString.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\MarkupString.Html\MarkupString.Html.csproj" />
    <ProjectReference Include="..\MarkupString.Mxp\MarkupString.Mxp.csproj" />
    <ProjectReference Include="..\MarkupString.Pueblo\MarkupString.Pueblo.csproj" />
  </ItemGroup>
</Project>
